# ============================================================
# CELL 34: WHAT-IF ANALYSIS
# ============================================================

from ml_utils import ALL_FEATURES

# Select first restaurant
base = df_full.iloc[0]

# Create model input row
row = {
    feat: base[feat]
    for feat in ALL_FEATURES
}

print(
    "Base restaurant selected successfully."
)


# ============================================================
# CELL 35: RECOMPUTE DEPENDENT FEATURES
# ============================================================

def recompute_dependent_features(row):

    row = row.copy()

    # Commission cost
    row["CommissionCost"] = (
        row["UberEatsRevenue"]
        + row["DoorDashRevenue"]
    ) * row["CommissionRate"]

    # Uber Eats commission impact
    row["Commission_UE_Impact"] = (
        row["CommissionRate"]
        * row["UberEatsRevenue"]
    )

    # Self-delivery cost impact
    row["DeliveryCost_SD_Impact"] = (
        row["DeliveryCostPerOrder"]
        * row["SelfDeliveryOrders"]
    )

    # Growth-adjusted orders
    row["GrowthAdjustedOrders"] = (
        row["MonthlyOrders"]
        * row["GrowthFactor"]
    )

    return row


# ============================================================
# CELL 36: CURRENT PREDICTION
# ============================================================

current_row = (
    recompute_dependent_features(
        row
    )
)

current_input = (
    pd.DataFrame(
        [current_row]
    )[ALL_FEATURES]
)

current_pred = (
    best_pipeline.predict(
        current_input
    )[0]
)

print(
    f"Current Predicted Profit: "
    f"${current_pred:,.2f}"
)


# ============================================================
# CELL 37: WHAT-IF SCENARIO
# ============================================================

scenario_row = current_row.copy()

# Lower commission scenario
scenario_row["CommissionRate"] = 0.15

# Recalculate dependent features
scenario_row = (
    recompute_dependent_features(
        scenario_row
    )
)

scenario_input = (
    pd.DataFrame(
        [scenario_row]
    )[ALL_FEATURES]
)

scenario_pred = (
    best_pipeline.predict(
        scenario_input
    )[0]
)

diff = (
    scenario_pred
    - current_pred
)

if current_pred != 0:

    pct = (
        diff
        / current_pred
    ) * 100

else:

    pct = 0


print(
    f"Current Predicted Profit:  "
    f"${current_pred:,.2f}"
)

print(
    f"Scenario Predicted Profit: "
    f"${scenario_pred:,.2f}"
)

print(
    f"Profit Difference:          "
    f"${diff:,.2f}"
)

print(
    f"Percentage Change:          "
    f"{pct:+.2f}%"
)


# ============================================================
# CELL 38: SIMPLE OPTIMIZATION
# ============================================================

import itertools

candidates = []

for is_pct, ue_pct, dd_pct in itertools.product(
    [20, 30, 40, 50],
    [10, 20, 30],
    [10, 20, 30]
):

    # Calculate remaining Self-Delivery percentage
    sd_pct = (
        100
        - is_pct
        - ue_pct
        - dd_pct
    )

    # Skip invalid combinations
    if sd_pct < 0 or sd_pct > 100:
        continue

    # Copy current restaurant
    r = current_row.copy()

    # Update channel shares
    r.update({
        "InStoreShare": is_pct / 100,
        "UE_share": ue_pct / 100,
        "DD_share": dd_pct / 100,
        "SD_share": sd_pct / 100
    })

    # Recalculate dependent features
    r = (
        recompute_dependent_features(
            r
        )
    )

    # Prepare input
    optimization_input = (
        pd.DataFrame(
            [r]
        )[ALL_FEATURES]
    )

    # Predict profit
    pred = (
        best_pipeline.predict(
            optimization_input
        )[0]
    )

    candidates.append({
        "InStore%": is_pct,
        "UberEats%": ue_pct,
        "DoorDash%": dd_pct,
        "SelfDelivery%": sd_pct,
        "PredictedProfit": pred
    })


# ============================================================
# CELL 39: OPTIMIZATION RESULTS
# ============================================================

opt_df = (
    pd.DataFrame(candidates)
    .sort_values(
        "PredictedProfit",
        ascending=False
    )
    .reset_index(drop=True)
)

best_combo = opt_df.iloc[0]

if current_pred != 0:

    uplift = (
        (
            best_combo["PredictedProfit"]
            - current_pred
        )
        / current_pred
    ) * 100

else:

    uplift = 0


print(
    "Current Predicted Profit:   "
    "${:,.2f}".format(
        current_pred
    )
)

print(
    "Optimized Predicted Profit: "
    "${:,.2f}".format(
        best_combo["PredictedProfit"]
    )
)

print(
    "Optimization Uplift:        "
    "{:+.2f}%".format(
        uplift
    )
)

print("\nBest Channel Mix:")

print(
